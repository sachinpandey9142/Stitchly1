  "react_native_rules": {
    "styling": [
      "Use StyleSheet.create() for performance.",
      "Avoid inline styles for complex objects.",
      "Use SafeAreaView from 'react-native-safe-area-context'.",
      "Use KeyboardAvoidingView for forms.",
      "Images: Use 'contentFit'='cover' from 'expo-image' if available, else Image 'resizeMode'='cover'."
    ],
    "navigation": [
      "Use 'expo-router' with Stack and Tabs.",
      "Hide header shadows for a clean look: headerShadowVisible: false",
      "Custom back button with Lucide 'ArrowLeft' icon."
    ],
    "components": [
      "TouchableOpacity: always set activeOpacity={0.7}",
      "FlatList: always set showsVerticalScrollIndicator={false}",
      "Status Bar: Use 'expo-status-bar' style='dark' on light backgrounds."
    ]
  },
  "universal_guidelines": [
    "Do NOT use 'Inter' font.",
    "Do NOT use gradients on text.",
    "Do NOT use purple or default blue.",
    "Always use a 'Loader' component for async states.",
    "All touchables must be at least 44x44 points for hit slop."
  ],
  "instructions_to_main_agent": "You are building a React Native Expo app. Follow these design guidelines strictly. Use the provided colors and fonts. Implement the 'Stitchly' brand as a premium, trustworthy Indian tailoring marketplace. Mock the Razorpay payment flow visually."
